<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <size android:height="@dimen/scan_view_original_height" />
            <corners android:radius="@dimen/scan_view_original_background_radius" />
            <solid android:color="@color/scan_view_original_button_press_color" />
            <stroke android:width="@dimen/scan_view_original_bg_stroke" android:color="@color/scan_view_original_button_stroke_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:height="@dimen/scan_view_original_height" />
            <corners android:radius="@dimen/scan_view_original_background_radius" />
            <solid android:color="@color/scan_view_original_button_color" />
            <stroke android:width="@dimen/scan_view_original_bg_stroke" android:color="@color/scan_view_original_button_stroke_color" />
        </shape>
    </item>
</selector>
