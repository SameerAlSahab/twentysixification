<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/language_and_region_settings" android:key="language_and_region_settings"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.widget.TopIntroPreference android:persistent="false" android:title="@string/desc_introduction_of_language_picker" android:selectable="false" />
    <PreferenceCategory android:title="@string/locale_picker_category_title" android:key="languages_category">
        <com.android.settingslib.widget.ButtonPreference android:icon="@drawable/ic_add_24dp" android:title="@string/add_a_language" android:key="add_a_language" android:order="500" app:buttonPreferenceSize="large" app:buttonPreferenceType="tonal" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/more_language_settings_category" android:key="more_language_settings_category" app:controller="com.android.settings.language.MoreLanguagesSettingsCategoryController">
        <Preference android:title="@string/app_locales_picker_menu_title" android:key="apps_language_in_more_language_settings" android:summary="@string/app_locale_picker_summary" android:fragment="com.android.settings.applications.manageapplications.ManageApplications" app:controller="com.android.settings.applications.appinfo.AppsLocalePreferenceController">
            <extra android:name="classname" android:value="com.android.settings.applications.appinfo.AppLocaleDetails" />
        </Preference>
        <Preference android:title="@string/speech_preference_title" android:key="speech_preference" android:summary="@string/speech_preference_summary" android:fragment="com.android.settings.language.SpeechSettings" />
        <Preference android:title="@string/terms_of_address_title" android:key="terms_of_address_in_more_language_settings" android:summary="@string/terms_of_address_summary" android:fragment="com.android.settings.localepicker.TermsOfAddressFragment" app:controller="com.android.settings.localepicker.TermsOfAddressPreferenceController" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/regional_preferences_category_title" android:key="regional_preferences_category" app:controller="com.android.settings.regionalpreferences.RegionalPreferencesCategoryController">
        <Preference android:title="@string/region_picker_preference_title" android:key="region_preference" app:controller="com.android.settings.regionalpreferences.RegionPreferenceController" app:fragment="com.android.settings.regionalpreferences.RegionPickerFragment" />
        <Preference android:title="@string/temperature_preferences_title" android:key="temperature_preference" android:summary="@string/default_string_of_regional_preference" app:controller="com.android.settings.regionalpreferences.TemperatureUnitPreferenceController" app:fragment="com.android.settings.regionalpreferences.TemperatureUnitFragment">
            <extra android:name="arg_key_regional_preference" android:value="mu" />
        </Preference>
        <Preference android:title="@string/measurement_system_preferences_title" android:key="key_measurement_system" android:summary="@string/default_string_of_regional_preference" app:controller="com.android.settings.regionalpreferences.MeasurementSystemController" app:fragment="com.android.settings.regionalpreferences.MeasurementSystemItemFragment">
            <extra android:name="arg_key_regional_preference" android:value="ms" />
        </Preference>
        <Preference android:title="@string/first_day_of_week_preferences_title" android:key="first_day_of_week_preference" android:summary="@string/default_string_of_regional_preference" app:controller="com.android.settings.regionalpreferences.FirstDayOfWeekPreferenceController" app:fragment="com.android.settings.regionalpreferences.FirstDayOfWeekItemFragment">
            <extra android:name="arg_key_regional_preference" android:value="fw" />
        </Preference>
        <Preference android:title="@string/numbers_preferences_title" android:key="numbering_system_preference" android:summary="@string/default_string_of_regional_preference" app:controller="com.android.settings.regionalpreferences.NumberingSystemController" app:fragment="com.android.settings.regionalpreferences.NumberingSystemLocaleListFragment">
            <extra android:name="arg_key_regional_preference" android:value="arg_value_language_select" />
        </Preference>
    </PreferenceCategory>
    <com.android.settingslib.widget.FooterPreference android:title="@string/title_regional_pref_footer" android:key="language_and_region_footer_preference" app:controller="com.android.settings.regionalpreferences.LanguageAndRegionFooterPreferenceController" app:searchable="false" />
</PreferenceScreen>
