<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/notification_popup_style" settings:hierarchicalParentFragment="com.android.settings.notification.ConfigureNotificationSettings" settings:topLevelPreferenceKey="top_level_notifications"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <SecPreferenceCategory android:title="@string/notification_popup_style_header_title" android:key="popup_style_header" settings:allowDividerAbove="false">
        <com.samsung.android.settings.widget.SecHorizontalRadioPreference android:title="@string/notification_popup_style" android:key="notification_popup_style" settings:controller="com.samsung.android.settings.notification.brief.NotificationPopUpStylePreferenceController" settings:viewType="image" />
    </SecPreferenceCategory>
    <com.samsung.android.settings.widget.SecUnclickablePreference android:title="@string/sec_detailed_pop_up_settings_in_app_desc" android:key="brief_apps_that_can_show_content_description" settings:searchable="false" />
    <com.android.settingslib.widget.LayoutPreference android:layout="@layout/sec_bullet_desc_text" android:selectable="false" android:key="summary_key" />
    <PreferenceCategory android:title="@string/sec_brief_popup_settings" android:key="brief_popup_settings">
        <SecPreference android:title="@string/brief_popup_style_settings_title" android:key="brief_popup_style_settings" settings:controller="com.samsung.android.settings.notification.brief.BriefPopUpStyleController" />
        <SecPreference android:title="@string/brief_popup_keyword_color_settings_title" android:key="brief_popup_keyword_color_settings" android:fragment="com.samsung.android.settings.notification.brief.BriefPopUpKeywordColorSettings" settings:controller="com.samsung.android.settings.notification.brief.BriefPopUpKeywordColorController" />
    </PreferenceCategory>
    <com.samsung.android.settings.widget.SecInsetCategoryPreference />
    <com.samsung.android.settings.widget.SecDisabledAppearanceSwitchPreference android:title="@string/brief_popup_show_even_screen_off_title" android:key="brief_popup_show_even_screen_off" settings:controller="com.samsung.android.settings.notification.brief.BriefPopUpConditionController" />
    <SecPreferenceCategory settings:allowDividerAbove="false">
        <SeslPreferenceCaption android:title="@string/brief_popup_show_even_screen_off_caption" android:selectable="true" android:key="brief_popup_show_even_screen_off_caption" settings:searchable="false" />
    </SecPreferenceCategory>
    <com.samsung.android.settings.widget.SecInsetCategoryPreference android:visible="false" android:key="brief_pop_up_power_saving_preference_inset" />
    <com.android.settingslib.widget.LayoutPreference android:layout="@layout/sec_brief_popup_power_saving_preference" android:key="brief_pop_up_power_saving_preference" settings:controller="com.samsung.android.settings.notification.brief.BriefPopupPowerSavingPreferenceController" />
</PreferenceScreen>
