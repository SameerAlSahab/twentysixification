        <ListPreference android:entries="@array/dev_network_mode_entries" android:title="@string/sim2_dev_network_mode_title" android:key="dev_sim_network_mode1" android:dialogTitle="@string/dev_network_mode_dialog_title_sim2" android:entryValues="@array/dev_network_mode_values" />
