    </PreferenceCategory>
    <PreferenceCategory android:order="1400">
        <ListPreference android:entries="@array/sa_logging_checking_titles" android:title="@string/sa_logging_checking_title" android:key="sa_logging_checking" android:dialogTitle="@string/sa_logging_checking_dialog_title" android:entryValues="@array/sa_logging_checking_values" />
