<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/bluetooth" android:key="bluetooth_development_settings_screen"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/debug_debugging_category" android:key="bluetooth_logging_category" android:order="100">
        <ListPreference android:entries="@array/bt_stack_log_level_entries" android:title="@string/bt_stack_log_level" android:key="bt_stack_log_level" android:dialogTitle="@string/bt_stack_log_level_summary" android:entryValues="@array/bt_stack_log_level_values" />
        <ListPreference android:entries="@array/bt_hci_snoop_log_entries" android:title="@string/bt_hci_snoop_log" android:key="bt_hci_snoop_log" android:dialogTitle="@string/bt_hci_snoop_log_summary" android:entryValues="@array/bt_hci_snoop_log_values" />
        <SwitchPreferenceCompat android:title="@string/bt_hci_snoop_log_socket_title" android:key="bt_hci_snoop_log_socket" android:summary="@string/bt_hci_snoop_log_socket_summary" />
        <Preference android:title="@string/bt_hci_snoop_log_filters_dashboard_title" android:key="snoop_logger_filters_dashboard" android:fragment="com.android.settings.development.snooplogger.SnoopLoggerFiltersDashboard" />
        <ListPreference android:entries="@array/bt_hci_snoop_log_profile_filter_entries" android:title="@string/bt_hci_snoop_log_filter_pbap_title" android:key="bt_hci_snoop_log_filter_pbap" android:dialogTitle="@string/bt_hci_snoop_log_filter_summary" android:entryValues="@array/bt_hci_snoop_log_profile_filter_values" />
        <ListPreference android:entries="@array/bt_hci_snoop_log_profile_filter_entries" android:title="@string/bt_hci_snoop_log_filter_map_title" android:key="bt_hci_snoop_log_filter_map" android:dialogTitle="@string/bt_hci_snoop_log_filter_summary" android:entryValues="@array/bt_hci_snoop_log_profile_filter_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="General" android:key="bluetooth_general_category" android:order="200">
        <SwitchPreferenceCompat android:title="@string/bluetooth_show_devices_without_names" android:key="bluetooth_show_devices_without_names" android:summary="@string/bluetooth_show_devices_without_names_summary" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_disable_absolute_volume" android:key="bluetooth_disable_absolute_volume" android:summary="@string/bluetooth_disable_absolute_volume_summary" />
        <ListPreference android:entries="@array/bluetooth_avrcp_versions" android:title="@string/bluetooth_select_avrcp_version_string" android:key="bluetooth_select_avrcp_version" android:dialogTitle="@string/bluetooth_select_avrcp_version_dialog_title" android:entryValues="@array/bluetooth_avrcp_version_values" />
        <ListPreference android:entries="@array/bluetooth_map_versions" android:title="@string/bluetooth_select_map_version_string" android:key="bluetooth_select_map_version" android:dialogTitle="@string/bluetooth_select_map_version_dialog_title" android:entryValues="@array/bluetooth_map_version_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Audio" android:key="bluetooth_audio_category" android:order="300">
        <ListPreference android:entries="@array/bluetooth_leaudio_mode" android:title="@string/bluetooth_leaudio_mode" android:key="bluetooth_leaudio_mode" android:summary="@string/summary_placeholder" android:entryValues="@array/bluetooth_leaudio_mode_values" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_show_leaudio_device_details" android:key="bluetooth_show_leaudio_device_details" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_bypass_leaudio_allowlist" android:key="bluetooth_bypass_leaudio_allowlist" android:summary="@string/bluetooth_bypass_leaudio_allowlist_summary" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_disable_le_audio_hw_offload" android:key="bluetooth_disable_le_audio_hw_offload" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_disable_a2dp_hw_offload" android:key="bluetooth_disable_a2dp_hw_offload" />
        <SwitchPreferenceCompat android:title="@string/bluetooth_profile_a2dp_high_quality_unknown_codec" android:key="bluetooth_hd_audio_settings" />
        <ListPreference android:title="@string/bluetooth_select_a2dp_codec_type" android:key="bluetooth_audio_codec_settings_list" android:dialogTitle="@string/bluetooth_select_a2dp_codec_type_dialog_title" />
        <com.android.settings.development.bluetooth.BluetoothSampleRateDialogPreference android:title="@string/bluetooth_select_a2dp_codec_sample_rate" android:key="bluetooth_sample_rate_settings" android:dialogTitle="@string/bluetooth_select_a2dp_codec_sample_rate_dialog_title" android:positiveButtonText="" android:negativeButtonText="@string/dlg_ok" android:dialogLayout="@layout/bluetooth_audio_sample_rate_dialog" />
        <com.android.settings.development.bluetooth.BluetoothBitPerSampleDialogPreference android:title="@string/bluetooth_select_a2dp_codec_bits_per_sample" android:key="bluetooth_bit_per_sample_settings" android:dialogTitle="@string/bluetooth_select_a2dp_codec_bits_per_sample_dialog_title" android:positiveButtonText="" android:negativeButtonText="@string/dlg_ok" android:dialogLayout="@layout/bluetooth_audio_bit_per_sample_dialog" />
        <com.android.settings.development.bluetooth.BluetoothChannelModeDialogPreference android:title="@string/bluetooth_select_a2dp_codec_channel_mode" android:key="bluetooth_channel_mode_settings" android:dialogTitle="@string/bluetooth_select_a2dp_codec_channel_mode_dialog_title" android:positiveButtonText="" android:negativeButtonText="@string/dlg_ok" android:dialogLayout="@layout/bluetooth_audio_channel_mode_dialog" />
        <com.android.settings.development.bluetooth.BluetoothQualityDialogPreference android:title="@string/bluetooth_select_a2dp_codec_ldac_playback_quality" android:key="bluetooth_a2dp_ldac_playback_quality" android:dialogTitle="@string/bluetooth_select_a2dp_codec_ldac_playback_quality_dialog_title" android:positiveButtonText="" android:negativeButtonText="@string/dlg_ok" android:dialogLayout="@layout/bluetooth_audio_quality_dialog" />
        <ListPreference android:entries="@array/bluetooth_max_connected_audio_devices" android:title="@string/bluetooth_max_connected_audio_devices_string" android:key="bluetooth_max_connected_audio_devices" android:dialogTitle="@string/bluetooth_max_connected_audio_devices_dialog_title" android:entryValues="@array/bluetooth_max_connected_audio_devices_values" />
    </PreferenceCategory>
</PreferenceScreen>
