<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:key="lock_settings_picker"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.RestrictedPreference android:icon="@drawable/ic_lock_none" android:persistent="false" android:title="@string/unlock_set_unlock_off_title" android:key="unlock_set_off" />
    <com.android.settingslib.RestrictedPreference android:icon="@drawable/ic_lock_swipe" android:persistent="false" android:title="@string/unlock_set_unlock_none_title" android:key="unlock_set_none" />
    <com.android.settingslib.RestrictedPreference android:icon="@drawable/ic_pattern" android:persistent="false" android:title="@string/unlock_set_unlock_pattern_title" android:key="unlock_set_pattern" />
    <com.android.settingslib.RestrictedPreference android:icon="@drawable/ic_lock_pin" android:persistent="false" android:title="@string/unlock_set_unlock_pin_title" android:key="unlock_set_pin" />
    <com.android.settingslib.RestrictedPreference android:icon="@drawable/ic_password" android:persistent="false" android:title="@string/unlock_set_unlock_password_title" android:key="unlock_set_password" />
    <com.android.settingslib.RestrictedPreference android:persistent="false" android:key="unlock_set_managed" />
    <com.android.settingslib.RestrictedPreference android:persistent="false" android:title="@string/fingerprint_unlock_skip_fingerprint" android:key="unlock_skip_fingerprint" />
    <com.android.settingslib.RestrictedPreference android:persistent="false" android:title="@string/face_unlock_skip_face" android:key="unlock_skip_face" />
    <com.android.settingslib.RestrictedPreference android:persistent="false" android:title="@string/biometrics_unlock_skip_biometrics" android:key="unlock_skip_biometrics" />
    <PreferenceCategory android:title="@string/lock_settings_screen_lock_settings_title" android:key="unlock_settings" settings:isPreferenceVisible="false">
        <SwitchPreferenceCompat android:title="@string/lockpattern_settings_enable_visible_pattern_title" android:key="visiblepattern" />
        <SwitchPreferenceCompat android:title="@string/lock_screen_auto_pin_confirm_title" android:key="auto_pin_confirm" android:summary="@string/lock_screen_auto_pin_confirm_summary" />
        <SwitchPreferenceCompat android:title="@string/lockpattern_settings_enhanced_pin_privacy_title" android:key="enhancedPinPrivacy" android:summary="@string/lockpattern_settings_enhanced_pin_privacy_summary" />
        <com.android.settings.security.screenlock.ProtectedTimeoutListPreference android:entries="@array/lock_after_timeout_entries" android:title="@string/lock_after_timeout" android:key="lock_after_timeout" android:summary="@string/summary_placeholder" android:entryValues="@array/lock_after_timeout_values" />
        <SwitchPreferenceCompat android:title="@string/lockpattern_settings_enable_power_button_instantly_locks" android:key="power_button_instantly_locks" />
    </PreferenceCategory>
    <com.android.settingslib.widget.FooterPreference android:key="lock_settings_footer" settings:searchable="false" />
</PreferenceScreen>
