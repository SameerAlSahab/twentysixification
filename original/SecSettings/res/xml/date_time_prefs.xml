<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/date_and_time" settings:keywords="@string/keywords_date_and_time"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.RestrictedSwitchPreference android:title="@string/date_time_auto" android:key="auto_time" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.AutoTimePreferenceController" settings:userRestriction="no_config_date_time" />
    <com.android.settingslib.RestrictedPreference android:title="@string/date_time_set_date_title" android:key="date" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.DatePreferenceController" settings:userRestriction="no_config_date_time" />
    <com.android.settingslib.RestrictedPreference android:title="@string/date_time_set_time_title" android:key="time" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.TimePreferenceController" settings:userRestriction="no_config_date_time" />
    <PreferenceCategory android:title="@string/date_time_set_timezone_title" android:key="timezone_preference_category">
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/zone_auto_title" android:key="auto_zone" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.AutoTimeZonePreferenceController" settings:userRestriction="no_config_date_time" />
        <com.android.settingslib.widget.BannerMessagePreference android:title="@string/location_time_zone_detection_status_title" android:key="location_time_zone_detection_status" settings:controller="com.android.settings.datetime.LocationProviderStatusPreferenceController" />
        <SwitchPreferenceCompat android:title="@string/location_time_zone_detection_toggle_title" android:key="location_time_zone_detection" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.LocationTimeZoneDetectionPreferenceController" />
        <com.android.settingslib.RestrictedPreference android:title="@string/date_time_set_timezone_title" android:key="timezone" android:summary="@string/summary_placeholder" android:fragment="com.android.settings.datetime.timezone.TimeZoneSettings" settings:controller="com.android.settings.datetime.TimeZonePreferenceController" settings:keywords="@string/keywords_time_zone" settings:userRestriction="no_config_date_time" />
        <com.android.settingslib.RestrictedPreference android:title="@string/home_time_zone_title" android:key="home_time_zone" android:summary="@string/summary_placeholder" android:fragment="com.android.settings.datetime.timezone.HomeTimeZoneSettings" settings:controller="com.android.settings.datetime.HomeTimeZonePreferenceController" settings:userRestriction="no_config_date_time" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/time_format_category_title" android:key="time_format_preference_category">
        <SwitchPreferenceCompat android:title="@string/date_time_24hour" android:key="24_hour" settings:controller="com.android.settings.datetime.TimeFormatPreferenceController" settings:keywords="@string/keywords_time_format" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/time_notifications_title" android:key="time_notifications_category" settings:controller="com.android.settings.datetime.NotificationsPreferenceCategoryController">
        <SwitchPreferenceCompat android:title="@string/time_zone_change_notifications_toggle_title" android:key="time_zone_change_notifications" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.TimeZoneNotificationsPreferenceController" settings:keywords="@string/keywords_time_notification_category" />
        <SwitchPreferenceCompat android:title="@string/time_zone_offset_change_notification_toggle_title" android:key="time_zone_offset_change_notification" android:summary="@string/time_zone_offset_change_notification_toggle_summary" settings:controller="com.android.settings.datetime.TimeZoneOffsetChangeNotificationsPreferenceController" settings:keywords="@string/keywords_time_zone_offset_change_notification_category" />
        <Preference android:title="@string/footer_time_zone_offset_change_next_change" android:key="time_zone_offset_change_footer" android:summary="@string/summary_placeholder" settings:controller="com.android.settings.datetime.TimeZoneOffsetInfoPreferenceController" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/time_feedback_category_title" android:key="time_feedback_preference_category" settings:controller="com.android.settings.datetime.TimeFeedbackPreferenceCategoryController" settings:keywords="@string/keywords_time_feedback_category">
        <Preference android:title="@string/time_feedback_title" android:key="time_feedback" settings:controller="com.android.settings.datetime.TimeFeedbackPreferenceController" settings:keywords="@string/keywords_time_feedback" />
    </PreferenceCategory>
</PreferenceScreen>
