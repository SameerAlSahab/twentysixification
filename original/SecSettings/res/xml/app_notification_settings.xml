<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/notifications_title" android:key="app_notifications"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.widget.LayoutPreference android:layout="@layout/settings_entity_header" android:selectable="false" android:key="pref_app_header" />
    <com.android.settings.widget.SettingsMainSwitchPreference android:key="block" />
    <Preference android:key="block_desc" />
    <PreferenceCategory android:title="@string/notification_ai_features_title" android:key="ai_features" settings:isPreferenceVisible="false">
        <com.android.settingslib.PrimarySwitchPreference android:title="@string/notification_app_level_summarize_title" android:key="key_summarization" android:summary="@string/notification_app_level_summarize_subtext" />
        <com.android.settingslib.PrimarySwitchPreference android:title="@string/notification_app_level_bundle_title" android:key="key_type" android:summary="@string/notification_app_level_bundle_subtext" />
    </PreferenceCategory>
    <PreferenceCategory android:visibility="gone" android:layout="@layout/empty_view" android:title="@string/conversations_category_title" android:key="conversations" />
    <PreferenceCategory android:title="@string/notification_channels" android:key="channels" />
    <PreferenceCategory android:visibility="gone" android:layout="@layout/empty_view" android:key="pre_channels_fields">
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/allow_interruption" android:key="allow_sound" android:summary="@string/allow_interruption_summary" />
        <com.android.settings.RestrictedListPreference android:title="@string/app_notification_visibility_override_title" android:key="visibility_override" />
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/app_notification_override_dnd_title" android:key="bypass_dnd" android:summary="@string/app_notification_override_dnd_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/app_notification_settings" android:key="app_wide" settings:isPreferenceVisible="false">
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/live_notifications_switch" android:key="promoted_switch" android:summary="@string/live_notifications_desc" />
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/conversation_section_switch_title" android:key="invalid_conversation_switch" />
        <Preference android:key="invalid_conversation_info" />
        <Preference android:icon="@drawable/ic_create_bubble" android:title="@string/notification_bubbles_title" android:key="bubble_pref_link" settings:controller="com.android.settings.notification.app.BubbleSummaryPreferenceController" />
        <com.android.settingslib.RestrictedSwitchPreference android:title="@string/app_notification_fsi_permission_title" android:key="fsi_permission" android:summary="@string/app_notification_fsi_permission_summary" />
        <com.android.settingslib.RestrictedSwitchPreference android:icon="@drawable/ic_notification_dot" android:title="@string/notification_badge_title" android:key="badge" android:order="1001" settings:restrictedSwitchSummary="@string/enabled_by_admin" settings:useAdditionalSummary="true" />
        <Preference android:icon="@drawable/ic_settings_24dp" android:title="@string/app_settings_link" android:key="app_link" android:order="1003" />
    </PreferenceCategory>
</PreferenceScreen>
