<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/sec_screen_permission_page_title"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/sec_screen_permission_category" android:key="screen_permission_category">
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_always_allowed" android:key="allow" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_ask_every_time" android:key="default" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_dont_allow" android:key="ignore" />
    </PreferenceCategory>
    <com.samsung.android.settings.widget.SecUnclickablePreference android:title="@string/sec_screen_permission_footer_description_footer_description" android:selectable="false" android:key="screen_permission_footer_preference" settings:searchable="false" style="@style/description_text" />
    <com.android.settingslib.widget.LayoutPreference android:layout="@layout/sec_screen_permission_app_list_layout" android:selectable="false" android:key="screen_permission_app_list_preference" />
</PreferenceScreen>
