<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.widget.IntroPreference android:key="wifi_details_intro" />
    <com.android.settings.datausage.DataUsageSummaryPreference android:selectable="false" android:key="status_header" settings:isPreferenceVisible="false" />
    <com.android.settings.widget.LinkifySummaryPreference android:icon="@drawable/ic_info_outline_24dp" android:selectable="false" android:key="second_summary" />
    <com.android.settingslib.widget.BannerMessagePreference android:title="@string/wep_network_less_secure_warning_title" android:key="wep_less_secure_warning" settings:controller="com.android.settings.wifi.WepLessSecureWarningController" />
    <com.android.settingslib.widget.ActionButtonsPreference android:selectable="false" android:key="buttons" />
    <PreferenceCategory android:title="@string/hotspot_device_details_category" android:key="hotspot_device_details_category" settings:isPreferenceVisible="false">
        <Preference android:title="@string/hotspot_device_details_internet_source" android:selectable="false" android:key="hotspot_device_details_internet_source" settings:enableCopying="true" />
        <Preference android:icon="@drawable/ic_battery_full" android:title="@string/power_usage_summary_title" android:selectable="false" android:key="hotspot_device_details_battery" settings:enableCopying="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/hotspot_connection_category" android:key="hotspot_connection_category" settings:isPreferenceVisible="false" />
    <PreferenceCategory>
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_signal" android:key="signal_strength" />
        <com.android.settings.widget.NonClickablePreference android:icon="@drawable/ic_frequency_antenna" android:title="@string/wifi_frequency" android:key="frequency" />
        <com.android.settings.widget.NonClickablePreference android:icon="@drawable/ic_security_lock_24dp" android:title="@string/wifi_security" android:key="security" />
        <ListPreference android:icon="@drawable/ic_attach_money_black_24dp" android:entries="@array/wifi_metered_entries" android:title="@string/wifi_metered_title" android:key="metered" android:entryValues="@array/wifi_metered_values" />
        <ListPreference android:icon="@drawable/ic_wifi_privacy_24dp" android:entries="@array/wifi_privacy_entries" android:title="@string/wifi_privacy_settings" android:key="privacy" android:entryValues="@array/wifi_privacy_values" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_group_24dp" android:title="@string/wifi_share_preference_title" android:key="shared" android:summary="@string/wifi_share_preference_summary" />
        <SwitchPreferenceCompat android:icon="@drawable/ic_network_manage_24dp" android:title="@string/wifi_allow_edit_configuration_title" android:key="edit_configuration" android:summary="@string/wifi_allow_edit_configuration_summary" settings:isPreferenceVisible="true" />
        <com.android.settings.spa.preference.ComposePreference android:title="@string/wifi_privacy_settings" android:key="privacy_settings" settings:controller="com.android.settings.wifi.details2.WifiPrivacyPreferenceController" />
        <Preference android:title="@string/wifi_subscription" android:key="subscription_detail" android:summary="@string/wifi_subscription_summary" />
    </PreferenceCategory>
    <com.android.settingslib.widget.UntitledPreferenceCategory>
        <SwitchPreferenceCompat android:title="@string/wifi_auto_connect_title" android:key="auto_connect" android:summary="@string/wifi_auto_connect_summary" />
        <com.android.settings.spa.preference.ComposePreference android:key="certificate_details" settings:controller="com.android.settings.wifi.details2.CertificateDetailsPreferenceController" />
        <Preference android:title="@string/wifi_dpp_add_device" android:key="add_device_to_network" android:summary="@string/wifi_dpp_connect_network_using_qr_code" />
    </com.android.settingslib.widget.UntitledPreferenceCategory>
    <PreferenceCategory android:title="@string/wifi_setup_detail" android:key="ip_details_category">
        <com.android.settings.spa.preference.ComposePreference android:key="server_name" settings:controller="com.android.settings.wifi.details2.ServerNamePreferenceController" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_type_title" android:key="type" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_advanced_ssid_title" android:key="ssid" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/sim_card" android:key="eap_sim_subscription" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_advanced_randomized_mac_address_title" android:key="mac_address" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_ip_address" android:key="ip_address" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_gateway" android:key="gateway" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_details_subnet_mask" android:key="subnet_mask" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_details_dns" android:key="dns" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/tx_wifi_speed" android:key="tx_link_speed" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/rx_wifi_speed" android:key="rx_link_speed" settings:enableCopying="true" />
        <com.android.settings.widget.NonClickablePreference android:title="@string/wifi_details_ipv6_address_header" android:key="ipv6_addresses" settings:enableCopying="true" />
    </PreferenceCategory>
    <com.android.settingslib.widget.FooterPreference android:title="@string/edit_wifi_network_non_owner_message" android:key="shared_network_footer" settings:isPreferenceVisible="false" />
</PreferenceScreen>
