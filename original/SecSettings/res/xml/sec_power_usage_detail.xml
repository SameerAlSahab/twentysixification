<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <com.samsung.android.settings.widget.SecInsetCategoryPreference settings:height="1.0px" settings:roundStroke="none" />
    <com.android.settingslib.widget.LayoutPreference android:layout="@layout/sec_app_info_submenu_header" android:selectable="false" android:key="header_view" />
    <PreferenceCategory android:key="battery_optimization_mode_category" settings:controller="com.android.settings.fuelgauge.BatteryOptimizationModePreferenceController">
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/manager_battery_usage_unrestricted_title" android:key="unrestricted_preference" android:summary="@string/manager_battery_usage_unrestricted_summary" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/manager_battery_usage_optimized_title" android:key="optimized_preference" android:summary="@string/manager_battery_usage_optimized_summary" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_restricted_true_label" android:key="background_usage_allowability_switch" android:summary="@string/manager_battery_usage_restricted_summary" />
    </PreferenceCategory>
</PreferenceScreen>
