    <com.samsung.android.settings.widget.SecInsetCategoryPreference settings:height="1.0px" />
    <com.samsung.android.settings.accessibility.base.widget.InlineCuePreference android:selectable="false" android:key="screen_permission_assistant_card_preference" />
    <PreferenceCategory android:title="@string/sec_screen_permission_category" android:key="screen_permission_target_consent_category">
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_always_allowed" android:key="allow" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_ask_every_time" android:key="default" />
        <com.android.settingslib.widget.SelectorWithWidgetPreference android:title="@string/sec_screen_permission_dont_allow" android:key="ignore" />
