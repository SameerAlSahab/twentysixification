<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/interaction_and_dexterity_title"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
    <Preference android:title="@string/universal_switch_title" android:key="com.samsung.accessibility/com.samsung.accessibility.universalswitch.UniversalSwitchService" settings:controller="com.samsung.android.settings.accessibility.dexterity.UniversalSwitchPreferenceController" settings:keywords="@string/keywords_universal_switch">
        <intent android:action="com.samsung.accessibility.action.UNIVERSAL_SWITCH" />
    </Preference>
    <SecSwitchPreferenceScreen android:title="@string/assistant_menu_title" android:key="assistant_menu_preference" settings:controller="com.samsung.android.settings.accessibility.dexterity.AssistantMenuPreferenceController" settings:keywords="@string/keyword_assistant_menu">
        <intent android:action="com.samsung.accessibility.Assistant_Menu" />
    </SecSwitchPreferenceScreen>
    <SecSwitchPreferenceScreen android:title="@string/voice_access_title" android:key="com.google.android.apps.accessibility.voiceaccess/com.google.android.apps.accessibility.voiceaccess.JustSpeakService" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.VoiceAccessPreferenceController" settings:keywords="@string/keyword_sec_voice_access" />
    <PreferenceCategory android:title="@string/interaction_category_title" android:key="interactions">
        <Preference android:title="@string/answering_end_call_title" android:key="call_answering_ending" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.CallAnsweringEndingPreferenceController" settings:keywords="@string/keywords_answering_and_ending_calls">
            <intent android:action="com.samsung.android.app.telephonyui.action.OPEN_CALL_SETTINGS">
                <extra android:name="root_key" android:value="ANSWERING_AND_ENDING_CALLS" />
                <extra android:name="is_exclude_hierarchy" android:value="true" />
            </intent>
        </Preference>
    </PreferenceCategory>
    <PreferenceCategory>
        <SwitchPreference android:title="@string/replace_swipe_with_single_tap_title" android:key="replace_swipe_with_single_tap" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.ReplaceSwipeWithSingleTapPreferenceController" />
        <SeslPreferenceCaption android:title="@string/replace_swipe_with_single_tap_summary" />
    </PreferenceCategory>
    <SecSwitchPreferenceScreen android:title="@string/easy_screen_turn_on_title" android:key="air_motion_wake_up" android:fragment="com.samsung.android.settings.accessibility.dexterity.EasyScreenTurnOnPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.EasyScreenTurnOnPreferenceController" settings:keywords="@string/keywords_airmotion_wakeup" />
    <Preference android:title="@string/accessibility_access_control_title" android:key="access_control_key" settings:controller="com.samsung.android.settings.accessibility.dexterity.AccessControlPreferenceController" settings:keywords="@string/keywords_interaction_control">
        <intent android:action="com.samsung.accessibility.action.INTERACTION_CONTROL" />
    </Preference>
    <Preference android:title="@string/accessibility_control_timeout_preference_title" android:key="accessibility_control_timeout_preference_fragment" android:fragment="com.samsung.android.settings.accessibility.dexterity.SecAccessibilityControlTimeoutPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.SecAccessibilityTimeoutPreferenceController" settings:keywords="@string/keywords_time_take_action" />
    <PreferenceCategory android:title="@string/touch_settings_category_title" android:key="touch_settings">
        <Preference android:persistent="false" android:title="@string/touch_and_hold_delay_header" android:key="select_long_press_timeout_preference" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.TouchAndHoldPreferenceController" settings:keywords="@string/keyword_touch_and_hold" />
        <Preference android:title="@string/tap_duration_title" android:key="tap_duration_key" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.TapDurationPreferenceController" settings:keywords="@string/keyword_tap_duration" />
        <Preference android:title="@string/accessibility_ignore_repeat" android:key="ignore_repeat_key" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.IgnoreRepeatPreferenceController" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/accessibility_mouse_settings_category_tile" android:key="mouse_settings">
        <Preference android:persistent="false" android:title="@string/accessibility_dwell_actions_title" android:key="sec_autoclick_preference" android:fragment="com.samsung.android.settings.accessibility.dexterity.autoclick.AutoClickPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.autoclick.SecAutoClickPreferenceController" settings:keywords="@string/keywords_auto_click" />
        <Preference android:title="@string/accessibility_corner_actions_title" android:key="auto_action_preference_screen" android:fragment="com.samsung.android.settings.accessibility.dexterity.autoaction.AutoActionPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.autoaction.AutoActionPreferenceController" settings:keywords="@string/keywords_auto_click_after_pointer_stop" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/mouse_physical_keyboard_category_title" android:key="mouse_physical_keyboard">
        <Preference android:persistent="false" android:title="@string/sticky_keys" android:key="sticky_keys" android:fragment="com.samsung.android.settings.accessibility.dexterity.StickyKeysPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.StickyKeysPreferenceController" settings:keywords="@string/keywords_bounce_slow_key" />
        <Preference android:title="@string/slow_keys" android:key="slow_keys" android:fragment="com.samsung.android.settings.accessibility.dexterity.SlowKeysPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.SlowKeysPreferenceController" settings:keywords="@string/keywords_mouse_keyboard" />
        <Preference android:title="@string/bounce_keys" android:key="bounce_keys" android:fragment="com.samsung.android.settings.accessibility.dexterity.BounceKeysPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.BounceKeysPreferenceController" settings:keywords="@string/keywords_mouse_keyboard" />
        <Preference android:title="@string/accessibility_mouse_keys" android:key="accessibility_mouse_keys" android:fragment="com.samsung.android.settings.accessibility.dexterity.MouseKeysPreferenceFragment" settings:controller="com.samsung.android.settings.accessibility.dexterity.controllers.MouseKeysPreferenceController" settings:keywords="@string/keywords_mouse_keyboard" />
    </PreferenceCategory>
</PreferenceScreen>
