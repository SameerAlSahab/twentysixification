<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/entity_header" android:paddingBottom="@dimen/settingslib_expressive_space_none" android:layout_width="fill_parent" android:layout_height="wrap_content" style="@style/SettingsLibEntityHeader"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
